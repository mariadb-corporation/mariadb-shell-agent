{
  "name": "mariadb-shell-agent",
  "private": true,
  "displayName": "MariaDB Shell Agent",
  "description": "An AI agent for MariaDB, with direct access to your VS Code workspace.",
  "version": "0.26.5",
  "publisher": "MariaDB",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariadb-corporation/mariadb-shell-agent.git",
    "directory": "packages/vscode-ide-companion"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "license": "LICENSE",
  "preview": true,
  "categories": [
    "AI"
  ],
  "keywords": [
    "mariadb",
    "mariadb shell",
    "mariadb shell agent",
    "ai",
    "agent",
    "cli",
    "ide companion"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:mariadb-shell-agent.chatView.sidebar",
    "onCommand:mariadb-shell-agent.openChat",
    "onCommand:mariadb-shell-agent.focusChat",
    "onCommand:mariadb-shell-agent.newConversation",
    "onCommand:mariadb-shell-agent.showLogs"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/.mariadb-shell-agent/settings.json",
        "url": "./schemas/settings.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mariadb-shell-agent-sidebar",
          "title": "MariaDB Shell Agent",
          "icon": "assets/activity-bar-78bbfacd.svg"
        }
      ]
    },
    "views": {
      "mariadb-shell-agent-sidebar": [
        {
          "type": "webview",
          "id": "mariadb-shell-agent.chatView.sidebar",
          "name": "MariaDB Shell Agent",
          "icon": "assets/activity-bar-78bbfacd.svg"
        }
      ]
    },
    "languages": [
      {
        "id": "mariadb-shell-agent-diff-editable"
      }
    ],
    "commands": [
      {
        "command": "mariadb-shell-agent.diff.accept",
        "title": "MariaDB Shell Agent: Accept Current Diff",
        "icon": "$(check)"
      },
      {
        "command": "mariadb-shell-agent.diff.cancel",
        "title": "MariaDB Shell Agent: Close Diff Editor",
        "icon": "$(close)"
      },
      {
        "command": "mariadb-shell-agent.runQwenCode",
        "title": "MariaDB Shell Agent: Run"
      },
      {
        "command": "mariadb-shell-agent.showNotices",
        "title": "MariaDB Shell Agent: View Third-Party Notices"
      },
      {
        "command": "mariadb-shell-agent.openChat",
        "title": "MariaDB Shell Agent: Open",
        "icon": "./assets/icon.png"
      },
      {
        "command": "mariadb-shell-agent.auth",
        "title": "MariaDB Shell Agent: Auth"
      },
      {
        "command": "mariadb-shell-agent.focusChat",
        "title": "MariaDB Shell Agent: Focus Chat View"
      },
      {
        "command": "mariadb-shell-agent.newConversation",
        "title": "MariaDB Shell Agent: New Conversation"
      },
      {
        "command": "mariadb-shell-agent.showLogs",
        "title": "MariaDB Shell Agent: Show Logs"
      },
      {
        "command": "mariadb-shell-agent.copyMessage",
        "title": "%mariadb-shell-agent.copyMessage.title%"
      },
      {
        "command": "mariadb-shell-agent.copyAllMessages",
        "title": "%mariadb-shell-agent.copyAllMessages.title%"
      },
      {
        "command": "mariadb-shell-agent.copyLastReply",
        "title": "%mariadb-shell-agent.copyLastReply.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mariadb-shell-agent.diff.accept",
          "when": "mariadb-shell-agent.diff.isVisible"
        },
        {
          "command": "mariadb-shell-agent.diff.cancel",
          "when": "mariadb-shell-agent.diff.isVisible"
        },
        {
          "command": "mariadb-shell-agent.auth"
        },
        {
          "command": "mariadb-shell-agent.copyMessage",
          "when": "false"
        },
        {
          "command": "mariadb-shell-agent.copyAllMessages",
          "when": "false"
        },
        {
          "command": "mariadb-shell-agent.copyLastReply",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "mariadb-shell-agent.copyMessage",
          "when": "webviewSection == 'chat-messages'",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "mariadb-shell-agent.copyAllMessages",
          "when": "webviewSection == 'chat-messages'",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "mariadb-shell-agent.copyLastReply",
          "when": "webviewSection == 'chat-messages'",
          "group": "9_cutcopypaste@3"
        }
      ],
      "editor/title": [
        {
          "command": "mariadb-shell-agent.diff.accept",
          "when": "mariadb-shell-agent.diff.isVisible",
          "group": "navigation"
        },
        {
          "command": "mariadb-shell-agent.diff.cancel",
          "when": "mariadb-shell-agent.diff.isVisible",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MariaDB Shell Agent",
      "properties": {
        "mariadb-shell-agent.dotIndicator": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "description": "Show a colored dot on the tab icon when a task completes (orange) or needs your attention (blue) while the tab is hidden."
        },
        "mariadb-shell-agent.notifications": {
          "order": 4,
          "type": "boolean",
          "default": true,
          "description": "Show notifications with sound when a task completes (at least 20 seconds) or needs your attention, while you are not actively viewing the MariaDB Shell Agent panel."
        },
        "mariadb-shell-agent.experimentalLsp": {
          "order": 5,
          "type": "boolean",
          "default": false,
          "description": "Start language servers (from .lsp.json files and extensions) for the agent's code intelligence. Experimental; takes effect for newly started sessions (reload the window)."
        }
      }
    },
    "keybindings": [
      {
        "command": "mariadb-shell-agent.diff.accept",
        "key": "ctrl+s",
        "when": "mariadb-shell-agent.diff.isVisible"
      },
      {
        "command": "mariadb-shell-agent.diff.accept",
        "key": "cmd+s",
        "when": "mariadb-shell-agent.diff.isVisible"
      },
      {
        "command": "mariadb-shell-agent.focusChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ]
  },
  "main": "./dist/extension.cjs",
  "type": "module",
  "scripts": {
    "prepackage": "node ./scripts/prepackage.js",
    "build": "npm run build:dev",
    "build:dev": "npm run check-types && npm run lint && node esbuild.js",
    "build:prod": "node esbuild.js --production",
    "generate:notices": "node ./scripts/generate-notices.js",
    "prepare": "npm run generate:notices",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "npm-run-all2 -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@qwen-code/qwen-code": "file:../cli",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "npm-run-all2": "^8.0.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qwen-code/acp-bridge": "*",
    "@qwen-code/qwen-code-core": "*",
    "@qwen-code/sdk": "*",
    "@qwen-code/web-shell": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^5.1.0",
    "lucide-react": "^1.24.0",
    "markdown-it": "^14.1.0",
    "punycode": "^2.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.7.2",
    "zod": "^3.25.76"
  }
}
