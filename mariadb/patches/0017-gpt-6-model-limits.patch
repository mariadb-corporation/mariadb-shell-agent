diff --git a/packages/core/src/core/reasoning-effort.ts b/packages/core/src/core/reasoning-effort.ts
index 069db142bd..d8315a473e 100644
--- a/packages/core/src/core/reasoning-effort.ts
+++ b/packages/core/src/core/reasoning-effort.ts
@@ -132,13 +132,24 @@ export function getGptReasoningCapabilities(model: string | undefined):
         defaultEnabled: true,
         thinkingMandatory: false,
       };
+    // GPT-6.x: Astra and Sol always reason; Terra and Luna also accept
+    // effort `none`, so thinking can be switched off.
     case 'gpt-6-astra':
+    case 'gpt-6.1-sol':
       return {
         efforts: REASONING_EFFORT_TIERS,
         defaultEffort: 'medium',
         defaultEnabled: true,
         thinkingMandatory: true,
       };
+    case 'gpt-6-luna':
+    case 'gpt-6.1-terra':
+      return {
+        efforts: REASONING_EFFORT_TIERS,
+        defaultEffort: 'medium',
+        defaultEnabled: true,
+        thinkingMandatory: false,
+      };
     default:
       return undefined;
   }
