+/**
+ * The interaction-mode reminder of a main session, for its startup prelude, or
+ * null when the session's system prompt is a full override (a configured
+ * system prompt or QWEN_SYSTEM_MD), which never carried mode guidance.
+ */
+export function getMainSessionInteractionModeReminder(config: {
+  getSystemPrompt(): string | undefined;
+  getExperimentalZedIntegration(): boolean;
+  getInputFormat?(): string;
+  isInteractive(): boolean;
+}): string | null {
+  if (config.getSystemPrompt() || isSystemMdActive()) return null;
+  return formatInteractionModeReminder(
+    getInteractionModePrompt(resolveInteractionMode(config)),
+  );
+}
