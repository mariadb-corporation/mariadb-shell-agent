+export function isAutoMemoryCatalogPart(part: Part): boolean {
+  return (
+    part.text?.startsWith(
+      `${SYSTEM_REMINDER_OPEN}\n${AUTO_MEMORY_CATALOG_HEADING}`,
+    ) === true
+  );
+}
+
+/** The newest memory catalog the contents carry, if any. */
+export function latestAutoMemoryCatalog(
+  contents: readonly Content[],
+): string | undefined {
+  for (let i = contents.length - 1; i >= 0; i--) {
+    const parts = contents[i]!.parts ?? [];
+    for (let j = parts.length - 1; j >= 0; j--) {
+      if (isAutoMemoryCatalogPart(parts[j]!)) return parts[j]!.text;
+    }
+  }
+  return undefined;
+}
 
