 import type { Content, Part } from '@google/genai';
 import { REATTACH_BOUNDARY_METADATA } from '../services/image-payload-references.js';
+import { SYSTEM_REMINDER_OPEN } from '../core/environmentContext.js';
+import { AUTO_MEMORY_CATALOG_HEADING } from './prompt.js';
+
+export function isAutoMemoryCatalogPart(part: Part): boolean {
+  return (
+    part.text?.startsWith(
+      `${SYSTEM_REMINDER_OPEN}\n${AUTO_MEMORY_CATALOG_HEADING}`,
+    ) === true
+  );
+}
+
+/** The newest memory catalog the contents carry, if any. */
+export function latestAutoMemoryCatalog(
+  contents: readonly Content[],
+): string | undefined {
+  for (let i = contents.length - 1; i >= 0; i--) {
+    const parts = contents[i]!.parts ?? [];
+    for (let j = parts.length - 1; j >= 0; j--) {
+      if (isAutoMemoryCatalogPart(parts[j]!)) return parts[j]!.text;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * The catalog part a new user message carries so that history holds the
+ * current catalog: none while the newest catalog in history is current.
+ * Keeping the catalog where it was first sent, instead of moving it to every
+ * newest message, lets each request extend the previous one unchanged
+ * (provider prompt caches).
+ */
+export function autoMemoryCatalogToAttach(
+  findLastHistoryEntry: (
+    predicate: (entry: Content) => boolean,
+  ) => Content | undefined,
+  catalog: string,
+): Part[] {
+  if (!catalog) return [];
+  const entry = findLastHistoryEntry(
+    (content) => content.parts?.some(isAutoMemoryCatalogPart) === true,
+  );
+  return entry && latestAutoMemoryCatalog([entry]) === catalog
+    ? []
+    : [{ text: catalog }];
+}
 
