+        };
+      }
+      break;
+    case 'apiKey':
+      title = t('wizard.apiKey.title');
+      prompt = t('wizard.apiKey.prompt');
+      input = {
+        field: 'apiKey',
+        placeholder: provider?.apiKeyPlaceholder ?? 'sk-...',
+      };
+      break;
+    case 'models':
