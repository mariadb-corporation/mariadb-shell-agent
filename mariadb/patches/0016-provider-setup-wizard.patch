+    default:
+      break;
+  }
+
+  const isLastStep = stepIndex === steps.length - 1;
+  const shownError = inputError ?? error;
+  const stepLabel = t('wizard.step')
+    .replace('{current}', String(stepIndex + 1))
+    .replace('{total}', String(steps.length));
+
+  return (
+    <div
+      ref={panelRef}
+      role="dialog"
+      aria-modal="true"
+      aria-label={t('wizard.title')}
+      data-auth-wizard=""
+      style={PANEL_STYLE}
+      onKeyDown={onKeyDown}
+    >
+      <div
+        style={{
+          display: 'flex',
+          width: 'min(100%, 360px)',
+          flexDirection: 'column',
+          gap: 12,
+          margin: 'auto',
+        }}
+      >
+        <div>
+          <div
+            style={{
+              color: 'var(--vscode-descriptionForeground)',
+              fontSize: 11,
+              lineHeight: 1.45,
+            }}
+          >
+            {/* The step count is known once a provider is picked. */}
+            {provider && step !== 'provider'
+              ? `${provider.label} · ${stepLabel}`
+              : t('wizard.title')}
+          </div>
+          <div style={{ marginTop: 2, fontSize: 15, fontWeight: 600 }}>
+            {title}
+          </div>
+          <div
+            style={{
+              marginTop: 2,
+              color: 'var(--vscode-descriptionForeground)',
+              fontSize: 12,
+              lineHeight: 1.5,
+            }}
+          >
+            {prompt}
+          </div>
+        </div>
+
+        {choices && (
+          <div
+            role="group"
+            aria-label={title}
+            style={{ display: 'flex', flexDirection: 'column', gap: 2 }}
+          >
+            {choices.map((choice) => {
+              const isSelected = choice.value === selected;
+              return (
+                <button
+                  key={choice.value}
+                  type="button"
+                  data-wizard-option=""
+                  aria-pressed={isSelected}
+                  disabled={submitting}
+                  className="qwen-vscode-wizard-option"
+                  onClick={() => choose(choice.value)}
+                  style={{
+                    ...OPTION_STYLE,
+                    ...(isSelected
+                      ? {
+                          borderColor: 'var(--vscode-focusBorder)',
+                          background:
+                            'var(--vscode-list-inactiveSelectionBackground)',
+                        }
+                      : {}),
+                    cursor: submitting ? 'wait' : 'pointer',
+                  }}
+                >
+                  <span style={{ fontWeight: 600 }}>{choice.label}</span>
+                  {choice.description && (
+                    <span
+                      style={{
+                        color: 'var(--vscode-descriptionForeground)',
+                        fontSize: 11,
+                        lineHeight: 1.45,
+                      }}
+                    >
+                      {choice.description}
+                    </span>
+                  )}
+                </button>
+              );
+            })}
+          </div>
+        )}
+
+        {input && (
+          <input
+            key={input.field}
+            data-wizard-input=""
+            aria-label={title}
+            type={input.field === 'apiKey' ? 'password' : 'text'}
+            autoComplete="off"
+            spellCheck={false}
+            disabled={submitting}
+            placeholder={input.placeholder}
+            value={answers[input.field]}
+            onChange={(event) => {
+              const value = event.target.value;
+              setInputError(undefined);
+              setAnswers((current) => ({ ...current, [input.field]: value }));
+            }}
+            onKeyDown={(event) => {
+              if (event.key === 'Enter') {
+                event.preventDefault();
+                confirmInput();
+              }
+            }}
+            style={INPUT_STYLE}
+          />
+        )}
+
+        {shownError && (
+          <div
+            role="alert"
+            style={{
+              color: 'var(--vscode-errorForeground)',
+              fontSize: 11,
+              lineHeight: 1.45,
+            }}
+          >
+            {shownError}
+          </div>
+        )}
+
+        <div style={{ display: 'flex', gap: 8, justifyContent: 'flex-end' }}>
+          {history.length > 1 && (
+            <button
+              type="button"
+              disabled={submitting}
+              onClick={back}
+              style={{ ...SECONDARY_BUTTON_STYLE, marginRight: 'auto' }}
+            >
+              {t('wizard.back')}
+            </button>
+          )}
+          <button
+            type="button"
+            disabled={submitting}
+            onClick={onCancel}
+            style={SECONDARY_BUTTON_STYLE}
+          >
+            {t('wizard.cancel')}
+          </button>
+          {(input || (submitting && isLastStep)) && (
+            <button
+              type="button"
+              disabled={submitting}
+              onClick={confirmInput}
+              style={{
+                ...PRIMARY_BUTTON_STYLE,
+                cursor: submitting ? 'wait' : 'pointer',
+                opacity: submitting ? 0.75 : 1,
+              }}
+            >
+              {submitting && (
+                <span
+                  aria-hidden="true"
+                  style={{
+                    width: 11,
+                    height: 11,
+                    border: '2px solid currentColor',
+                    borderTopColor: 'transparent',
+                    borderRadius: '50%',
+                    animation: 'qwen-vscode-spin 0.8s linear infinite',
+                  }}
+                />
+              )}
+              {submitting
+                ? t('wizard.connecting')
+                : isLastStep
+                  ? t('wizard.connect')
+                  : t('wizard.next')}
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
